# RecoverAI — Environment Variable Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
APP_NAME=RecoverAI
APP_ENV=development
DEBUG=false

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
# Port is typically injected by the cloud platform (Render, Fly, Railway).
# Set manually for local runs if needed.
# PORT=8000

# -----------------------------------------------------------------------
# Razorpay Webhook Secret
# Obtain from: Razorpay Dashboard → Webhooks → (your webhook) → Secret
# This is SEPARATE from your Razorpay API Key Secret.
# -----------------------------------------------------------------------
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -----------------------------------------------------------------------
# Database
# Local dev: SQLite (default)
# Production: PostgreSQL (e.g. postgresql://user:pass@host:5432/dbname)
# -----------------------------------------------------------------------
DATABASE_URL=sqlite:///recoverai.db
# Legacy Phase 0 SQLite path (retained for backward compatibility)
# DATABASE_PATH=recoverai.db

# -----------------------------------------------------------------------
# LLM / AI Engine
# Google Gemini API key for contextual reasoning (Phase 2+)
# -----------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------
# Razorpay API Credentials (Phase 3+)
# For Payment Link creation, order fetching, and automated recovery actions
# -----------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
